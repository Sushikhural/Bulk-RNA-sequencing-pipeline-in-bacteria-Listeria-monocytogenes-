#Pathway Analysis
library(clusterProfiler)
library(ggplot2)
#BiocManager::install("pathview")
library(pathview)
library(enrichplot)
install.packages("enrichR")
library(enrichR)

#BiocManager::install("biomaRt")
library(biomaRt)
library(ensembldb)


# Replace with your bacterial gene list with ENTREZ terms
DE_genes <- c("987300", "986061", "986063", "987397", "986752")  # Example bacterial genes
DE_genes <- c("lmo2515","lmo1210","lmo1211","lmo0269","lmo0136")  # Example bacterial gene


library(biomaRt)

# Set up connection to Ensembl using the 'biomaRt' package
mart <- useMart("ENSEMBL_MART_ENSEMBL", dataset = "listeria_monocytogenes_eg_gene")

# Convert Entrez IDs to KEGG IDs
entrez_ids <- c("987300", "986061", "986063", "987397", "986752")
kegg_ids <- getBM(attributes = c('entrezgene', 'kegg_gene'), 
                  filters = 'entrezgene', 
                  values = entrez_ids, 
                  mart = mart)

# Extract KEGG gene IDs
kegg_gene_ids <- kegg_ids$kegg_gene

# Perform KEGG pathway enrichment analysis
kegg_result <- enrichKEGG(
  gene = kegg_gene_ids,
  organism = "lmo",       # Replace with your organism's KEGG code
  pvalueCutoff = 0.05,
  qvalueCutoff = 0.2
)

# View and save results
head(kegg_gene_ids)
write.csv(kegg_gene_ids, "KEGG_Pathway_Results_Bacteria.csv")



# Visualize KEGG results
barplot(kegg_result, showCategory = 5, title = "KEGG Pathway Analysis")

dotplot(kegg_result, showCategory = 10, title = "KEGG Pathway Analysis")
# for gene pathway relationships
cnetplot(kegg_result, showCategory = 2, foldChange = NULL, layout = "kk")
#enrichment map for gene pathway similarity.
kegg_result <- pairwise_termsim(kegg_result)
emapplot(kegg_result, showCategory = 10, color = "p.adjust")
#tree plot for mother and daughter category relationships.
kegg_result <- pairwise_termsim(kegg_result) # calculate pairwise similarities of the enriched terms using Jaccard’s similarity index
treeplot(kegg_result)

